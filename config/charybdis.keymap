#define ZMK_POINTING_DEFAULT_MOVE_VAL 3500

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define FUNCTION 1
#define SYMBOLS 2
#define MOUSE 3
#define GAMING 4
#define NUMBERS 5
#define RUSSIAN 6

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&gresc {
    keep-mods = <(MOD_LGUI | MOD_LSFT | MOD_RGUI | MOD_RSFT)>;
};

&mmv {
    delay-ms = <0>;
    trigger-period-ms = <16>;
    time-to-max-speed-ms = <960>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        inverted_quote: inverted_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DQT>, <&kp SQT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        quote_lt: quote_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&inverted_quote>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp LC(TAB)  &kp N1          &kp N2          &kp N3        &kp N4          &kp N5               &kp N6          &kp N7             &kp N8             &kp N9          &kp N0             &kp PRINTSCREEN
&gresc       &kp Q           &kp W           &kp E         &kp R           &kp T                &kp Y           &kp U              &kp I              &kp O           &kp P              &kp BACKSLASH
&kp LSHIFT   &lt SYMBOLS A   &mt LSHIFT S    &mt LCTRL D   &mt LALT F      &kp G                &kp H           &mt RALT J          &mt RCTRL K         &mt RSHIFT L    &quote_lt SYMBOLS 0  &tog GAMING
&kp LCTRL    &kp Z           &kp X           &kp C         &lt NUMBERS V   &kp B                &kp N           &lt NUMBERS M       &kp COMMA          &kp DOT         &kp SLASH          &kp CAPSLOCK
                                                    &mkp RCLK       &mt LGUI ENTER   &mo FUNCTION     &mt LSHIFT SPACE  &kp BACKSPACE
                                                                    &lt FUNCTION TAB &mkp LCLK        &mt LSHIFT SPACE
            >;
        };

        Function {
            display-name = "Function";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3    &kp F4         &kp F5             &kp F6     &kp F7     &kp F8    &kp F9          &kp F10          &kp F11
&kp GRAVE  &trans    &trans    &trans    &trans         &trans             &kp HOME   &kp PG_DN  &kp PG_UP &kp END         &trans           &kp F12
&kp LSHIFT &trans    &trans    &trans    &trans         &trans             &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT       &trans           &trans
&studio_unlock &trans    &trans    &trans    &kp K_PASTE    &kp C_PLAY_PAUSE  &trans     &trans     &trans    &kp KP_MULTIPLY &kp KP_MULTIPLY  &kp KP_MULTIPLY
                                      &trans    &none     &trans    &trans    &kp DELETE
                                                &trans    &trans    &trans
            >;
        };

        Symbols {
            display-name = "Symbols";
            bindings = <
&trans      &trans    &trans        &trans      &trans            &trans    &trans    &trans       &trans     &trans    &trans     &trans
&kp GRAVE   &trans    &trans        &trans      &trans            &trans    &trans    &kp MINUS    &kp UNDER  &trans    &kp GRAVE  &trans
&kp LSHIFT  &trans    &kp LEFT_BRACE &kp LBKT   &kp LEFT_PARENTHESIS  &trans    &kp PLUS  &kp EQUAL    &kp COLON  &kp SEMI  &trans     &trans
&none       &trans    &kp RIGHT_BRACE &kp RBKT  &kp RIGHT_PARENTHESIS &trans    &trans    &none        &none      &trans    &trans     &trans
                                          &trans    &trans    &trans    &kp DELETE  &trans
                                                    &trans    &trans    &kp UNDER
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans           &trans           &trans         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans           &trans           &trans         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP  &mmv MOVE_RIGHT &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans           &trans           &trans         &trans          &trans
                              &trans  &trans  &trans  &trans  &trans
                                      &trans  &trans  &trans
            >;
        };

        Gaming {
            display-name = "Gaming";
            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp PRINTSCREEN
&kp TAB     &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LG(M)
&kp LSHIFT  &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SQT   &tog GAMING
&kp LCTRL   &kp Z   &kp X   &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp SLASH &kp CAPSLOCK
                                  &trans     &kp SPACE  &kp LALT  &kp BACKSPACE  &kp SPACE
                                             &kp SPACE  &trans    &kp ENTER
            >;
        };

        Numbers {
            display-name = "Numbers";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
                              &trans  &trans  &trans  &trans  &trans
                                      &trans  &trans  &trans
            >;
        };

        Russian {
            display-name = "Russian";
            bindings = <
&trans  &trans    &trans    &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans
&trans  &trans    &trans    &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans
&trans  &trans    &trans    &trans  &trans  &trans    &trans  &trans    &trans  &kp SEMI  &trans  &trans
&trans  &trans    &kp LBKT  &trans  &trans  &trans    &trans  &kp RBKT  &trans  &trans    &trans  &trans
                                &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans
            >;
        };
    };
};
